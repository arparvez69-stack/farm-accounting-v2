rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-tenant fixed owner allow-list for "The Goted Farm"
    function isApprovedOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          'arparvez69@gmail.com',
          'arparvez4@gmail.com',
          'arparvez111@gmail.com',
          'atikurrahman00021@gmail.com'
        ];
    }

    // System configuration for "The Goted Farm"
    match /system/config {
      allow read, write: if isApprovedOwner();
      allow delete: if false;
    }

    // Server-only OTP codes: never accessible by client direct queries
    match /loginCodes/{email} {
      allow read, write: if false;
    }

    // Chart of Accounts
    match /accounts/{accountId} {
      allow read, write: if isApprovedOwner();
    }

    // General Journal Entries
    match /journalEntries/{entryId} {
      allow read, write: if isApprovedOwner();
    }

    // Livestock Animals & Events
    match /animals/{animalId} {
      allow read, write: if isApprovedOwner();
    }
    match /animalEvents/{eventId} {
      allow read, write: if isApprovedOwner();
    }

    // Aquaculture Ponds & Fish Batches
    match /ponds/{pondId} {
      allow read, write: if isApprovedOwner();
    }
    match /fishBatches/{batchId} {
      allow read, write: if isApprovedOwner();
    }

    // Agriculture Plots & Crop Cycles
    match /plots/{plotId} {
      allow read, write: if isApprovedOwner();
    }
    match /cropCycles/{cycleId} {
      allow read, write: if isApprovedOwner();
    }

    // Inventory, Products & Stock Movements
    match /inventoryItems/{itemId} {
      allow read, write: if isApprovedOwner();
    }
    match /stockMovements/{movementId} {
      allow read, write: if isApprovedOwner();
    }

    // Purchases & Sales
    match /purchases/{purchaseId} {
      allow read, write: if isApprovedOwner();
    }
    match /sales/{saleId} {
      allow read, write: if isApprovedOwner();
    }

    // Parties (Customers & Suppliers)
    match /parties/{partyId} {
      allow read, write: if isApprovedOwner();
    }

    // Cash & Bank Accounts
    match /cashBankAccounts/{accId} {
      allow read, write: if isApprovedOwner();
    }

    // Loans
    match /loans/{loanId} {
      allow read, write: if isApprovedOwner();
    }

    // Investors & Transactions
    match /investors/{investorId} {
      allow read, write: if isApprovedOwner();
    }
    match /investorTransactions/{txId} {
      allow read, write: if isApprovedOwner();
    }

    // Fixed Assets
    match /fixedAssets/{assetId} {
      allow read, write: if isApprovedOwner();
    }

    // Permaculture & Internal Resource Flows
    match /internalFlows/{flowId} {
      allow read, write: if isApprovedOwner();
    }

    // Processing & BOM Runs
    match /processingRuns/{runId} {
      allow read, write: if isApprovedOwner();
    }

    // Audit logs: Append-only by approved owners for immutable audit trail, never update or delete
    match /auditLogs/{logId} {
      allow read: if isApprovedOwner();
      allow create: if isApprovedOwner();
      allow update, delete: if false;
    }
  }
}
