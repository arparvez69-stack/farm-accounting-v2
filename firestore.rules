rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-tenant fixed owner allow-list for "The Goated Farm"
    function isApprovedOwner() {
      return request.auth != null &&
        request.auth.token.email in [
          'arparvez69@gmail.com',
          'arparvez4@gmail.com',
          'arparvez111@gmail.com',
          'atikurrahman00021@gmail.com',
          'lubaiyatasnum111@gmail.com'
        ];
    }

    // System configuration for "The Goated Farm" - Server/Admin only write
    match /system/config {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Server-only auth secrets (bcrypt hashes): Admin SDK only, never accessible by client SDK
    match /system/authSecrets {
      allow read, write: if false;
    }

    // Server-only OTP codes: never accessible by client direct queries
    match /loginCodes/{email} {
      allow read, write: if false;
    }

    // Chart of Accounts: Read only for owners; written only via trusted backend
    match /accounts/{accountId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // General Journal Entries: Validated server-side, written via Admin SDK
    match /journalEntries/{entryId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Livestock Animals & Events: Validated server-side, written via Admin SDK
    match /animals/{animalId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
    match /animalEvents/{eventId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Aquaculture Ponds & Fish Batches: Validated server-side, written via Admin SDK
    match /ponds/{pondId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
    match /fishBatches/{batchId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Agriculture Plots & Crop Cycles: Validated server-side, written via Admin SDK
    match /plots/{plotId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
    match /cropCycles/{cycleId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Inventory, Products & Stock Movements: Validated server-side, written via Admin SDK
    match /inventoryItems/{itemId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
    match /stockMovements/{movementId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Purchases & Sales: Validated server-side, written via Admin SDK
    match /purchases/{purchaseId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
    match /sales/{saleId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Parties (Customers & Suppliers)
    match /parties/{partyId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Cash & Bank Accounts
    match /cashBankAccounts/{accId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Loans
    match /loans/{loanId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Investors & Transactions
    match /investors/{investorId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
    match /investorTransactions/{txId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Fixed Assets
    match /fixedAssets/{assetId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Permaculture & Internal Resource Flows
    match /internalFlows/{flowId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Processing & BOM Runs
    match /processingRuns/{runId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }

    // Audit logs: Read by approved owner, direct client write disabled (written via server-side admin SDK)
    match /auditLogs/{logId} {
      allow read: if isApprovedOwner();
      allow write: if false;
    }
  }
}
