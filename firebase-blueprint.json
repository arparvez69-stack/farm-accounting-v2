{
  "entities": {
    "systemConfig": {
      "title": "System Configuration",
      "description": "Global ERP configuration for The Goted Farm single-tenant instance",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "description": "Farm business name (The Goted Farm)" },
        "ownerEmails": { "type": "array", "items": { "type": "string" }, "description": "Fixed owner allow-list" },
        "currency": { "type": "string", "description": "BDT currency symbol" },
        "initializedAt": { "type": "string", "description": "ISO timestamp of system bootstrap" }
      },
      "required": ["companyName", "currency", "initializedAt"]
    },
    "account": {
      "title": "Chart of Account",
      "description": "Double-entry general ledger account definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Account unique code/ID" },
        "code": { "type": "string", "description": "Numeric code like 1010" },
        "nameBn": { "type": "string", "description": "Bangla name" },
        "nameEn": { "type": "string", "description": "English name" },
        "accountClass": { "type": "string", "enum": ["ASSET", "LIABILITY", "EQUITY", "REVENUE", "COGS", "EXPENSE", "OTHER_INCOME", "OTHER_EXPENSE"] },
        "parentCode": { "type": "string", "description": "Parent account code" },
        "normalBalance": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
        "isSystem": { "type": "boolean", "description": "Whether system account" },
        "isActive": { "type": "boolean", "description": "Active status" }
      },
      "required": ["id", "code", "nameBn", "accountClass", "normalBalance"]
    },
    "journalEntry": {
      "title": "Journal Entry",
      "description": "Balanced double entry transaction voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Voucher ID" },
        "voucherNumber": { "type": "string", "description": "Unique voucher sequential number" },
        "voucherType": { "type": "string", "enum": ["RECEIPT", "PAYMENT", "CONTRA", "JOURNAL", "PURCHASE", "SALES", "PURCHASE_RETURN", "SALES_RETURN", "ADJUSTMENT", "TRANSFER"] },
        "date": { "type": "string", "description": "ISO date string" },
        "narration": { "type": "string", "description": "Transaction description" },
        "lines": { "type": "string", "description": "Serialized balanced debit/credit lines" },
        "totalDebit": { "type": "number", "description": "Sum of debits" },
        "totalCredit": { "type": "number", "description": "Sum of credits" },
        "reference": { "type": "string", "description": "Invoice or source reference" },
        "createdBy": { "type": "string", "description": "UID of creator" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "voucherNumber", "voucherType", "date", "totalDebit", "totalCredit"]
    },
    "livestockAnimal": {
      "title": "Livestock Animal",
      "description": "Individual animal record for cattle or goat",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Animal Tag ID e.g. COW-001" },
        "species": { "type": "string", "enum": ["CATTLE", "GOAT", "SHEEP", "OTHER"] },
        "breed": { "type": "string", "description": "Breed name" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
        "birthDate": { "type": "string", "description": "Birth or acquisition date" },
        "purchaseCost": { "type": "number", "description": "Acquisition cost" },
        "currentWeightKg": { "type": "number", "description": "Latest weight" },
        "status": { "type": "string", "enum": ["ACTIVE", "SOLD", "DECEASED", "TRANSFERRED"] },
        "location": { "type": "string", "description": "Shed or barn location" },
        "accumulatedCost": { "type": "number", "description": "Feed + med + direct costs" }
      },
      "required": ["id", "species", "gender", "status"]
    },
    "fishBatch": {
      "title": "Fish Batch",
      "description": "Aquaculture pond fish batch",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Batch ID" },
        "pondId": { "type": "string", "description": "Pond ID" },
        "species": { "type": "string", "description": "Fish species e.g. Shing, Shol, Rui" },
        "stockingDate": { "type": "string", "description": "Date stocked" },
        "fingerlingQuantity": { "type": "number", "description": "Number of fingerlings stocked" },
        "fingerlingCost": { "type": "number", "description": "Total cost of fingerlings" },
        "currentFeedKg": { "type": "number", "description": "Total feed fed in kg" },
        "mortalityCount": { "type": "number", "description": "Total dead fish" },
        "harvestedWeightKg": { "type": "number", "description": "Total harvested kg" },
        "status": { "type": "string", "enum": ["ACTIVE", "HARVESTED", "CLOSED"] }
      },
      "required": ["id", "pondId", "species", "stockingDate", "fingerlingQuantity", "status"]
    },
    "cropCycle": {
      "title": "Crop Cycle",
      "description": "Seasonal crop planting and harvest cycle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Cycle ID" },
        "plotId": { "type": "string", "description": "Plot ID" },
        "cropName": { "type": "string", "description": "Crop name e.g. Paddy, Mustard, Maize" },
        "plantingDate": { "type": "string", "description": "Planting date" },
        "areaDecimals": { "type": "number", "description": "Area in decimals" },
        "totalCost": { "type": "number", "description": "Seeds, fertilizer, irrigation, labour" },
        "harvestYieldKg": { "type": "number", "description": "Harvested quantity" },
        "status": { "type": "string", "enum": ["PLANTED", "GROWING", "HARVESTED", "CLOSED"] }
      },
      "required": ["id", "plotId", "cropName", "plantingDate", "areaDecimals", "status"]
    },
    "auditLog": {
      "title": "Audit Log",
      "description": "Immutable security and transaction log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Audit ID" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "userId": { "type": "string", "description": "User UID" },
        "role": { "type": "string", "description": "User role at action" },
        "action": { "type": "string", "description": "Action performed" },
        "module": { "type": "string", "description": "ERP Module" },
        "recordId": { "type": "string", "description": "Target record ID" },
        "status": { "type": "string", "description": "SUCCESS or FAILURE" },
        "details": { "type": "string", "description": "JSON details or summary" }
      },
      "required": ["id", "timestamp", "userId", "role", "action", "module", "status"]
    },
    "authSecrets": {
      "title": "Authentication Secrets",
      "description": "Server-only bcrypt hashes and reset codes of owner secret PINs (Admin SDK only)",
      "type": "object",
      "properties": {
        "hashes": {
          "type": "object",
          "description": "Map of owner emails to bcrypt hash strings"
        },
        "resetCodes": {
          "type": "object",
          "description": "Temporary 6-digit password reset codes with 15-minute expiration"
        }
      }
    },
    "paymentRecord": {
      "title": "Payment Record",
      "description": "Invoice payment receipt or disbursement record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Payment unique identifier" },
        "parentType": { "type": "string", "enum": ["SALE", "PURCHASE"] },
        "parentId": { "type": "string", "description": "Parent invoice document ID" },
        "amount": { "type": "number", "description": "Payment amount" },
        "date": { "type": "string", "description": "Payment date" },
        "note": { "type": "string", "description": "Optional payment note" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "BANK"] },
        "bankAccountId": { "type": "string", "description": "Bank account ID if paid via bank" },
        "journalEntryId": { "type": "string", "description": "Associated journal entry voucher ID" },
        "voucherNumber": { "type": "string", "description": "Voucher number" },
        "idempotencyKey": { "type": "string", "description": "Unique key to prevent duplicate payments" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "parentType", "parentId", "amount", "date"]
    },
    "inventoryItem": {
      "title": "Inventory Item",
      "description": "Feed, seeds, fertilizers, farm products, and inventory stock",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Item ID" },
        "code": { "type": "string", "description": "Item SKU or code" },
        "nameBn": { "type": "string", "description": "Bengali name" },
        "nameEn": { "type": "string", "description": "English name" },
        "category": { "type": "string", "description": "Item category" },
        "unit": { "type": "string", "description": "Unit of measurement" },
        "currentStock": { "type": "number", "description": "Current stock quantity" },
        "reorderLevel": { "type": "number", "description": "Reorder level" },
        "avgCostPrice": { "type": "number", "description": "Average unit cost price" },
        "sellingPrice": { "type": "number", "description": "Default selling price" },
        "lowStockThreshold": { "type": "number", "description": "Low stock alert threshold" },
        "journalEntryId": { "type": "string", "description": "Associated opening journal entry ID" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "code", "nameBn", "category", "unit"]
    },
    "stockMovement": {
      "title": "Stock Movement",
      "description": "Inventory stock addition, consumption, transfer, or adjustment record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique movement ID" },
        "date": { "type": "string", "description": "Movement date (YYYY-MM-DD)" },
        "itemId": { "type": "string", "description": "Inventory item ID" },
        "movementType": {
          "type": "string",
          "enum": ["OPENING", "PURCHASE", "TRANSFER", "PRODUCTION", "CONSUMPTION", "SALE", "WASTE", "DAMAGE", "ADJUSTMENT"]
        },
        "quantity": { "type": "number", "description": "Quantity moved" },
        "unitCost": { "type": "number", "description": "Unit cost valuation" },
        "totalValue": { "type": "number", "description": "Total monetary value" },
        "referenceId": { "type": "string", "description": "Source reference voucher or record ID" },
        "notes": { "type": "string", "description": "Optional notes or details" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "date", "itemId", "movementType", "quantity"]
    },
    "cashBankAccount": {
      "title": "Cash and Bank Account",
      "description": "Cash, bank, or mobile banking account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Account unique ID" },
        "accountType": { "type": "string", "enum": ["CASH", "BANK", "MOBILE_BANKING"] },
        "name": { "type": "string", "description": "Account display name" },
        "accountName": { "type": "string", "description": "Bank account name" },
        "accountNumber": { "type": "string", "description": "Bank or mobile account number" },
        "bankName": { "type": "string", "description": "Name of financial institution" },
        "branch": { "type": "string", "description": "Branch name" },
        "currentBalance": { "type": "number", "description": "Current balance" },
        "balance": { "type": "number", "description": "Balance" },
        "code": { "type": "string", "description": "Ledger account code" },
        "openingBalance": { "type": "number", "description": "Initial balance" },
        "isActive": { "type": "boolean", "description": "Active status" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "accountType", "name"]
    },
    "loan": {
      "title": "Loan Record",
      "description": "Borrowing and debt obligation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Loan unique ID" },
        "lenderName": { "type": "string", "description": "Name of lender or institution" },
        "loanType": { "type": "string", "enum": ["BANK", "NGO", "INDIVIDUAL"] },
        "principalAmount": { "type": "number", "description": "Principal amount borrowed" },
        "interestRateAnnual": { "type": "number", "description": "Annual interest rate %" },
        "remainingBalance": { "type": "number", "description": "Remaining loan balance" },
        "disbursedDate": { "type": "string", "description": "Disbursement date" },
        "termMonths": { "type": "number", "description": "Loan term in months" },
        "monthlyInstallment": { "type": "number", "description": "Monthly EMI" },
        "status": { "type": "string", "enum": ["ACTIVE", "PAID_OFF"] },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "lenderName", "loanType", "principalAmount", "status"]
    },
    "investor": {
      "title": "Investor Record",
      "description": "Partner or investor capital and profit sharing profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Investor unique ID" },
        "name": { "type": "string", "description": "Investor name" },
        "phone": { "type": "string", "description": "Phone number" },
        "joinedDate": { "type": "string", "description": "Date joined" },
        "totalContribution": { "type": "number", "description": "Total capital contributed" },
        "profitSharingRatio": { "type": "number", "description": "Agreed profit share %" },
        "status": { "type": "string", "description": "Active status" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "name"]
    },
    "fixedAsset": {
      "title": "Fixed Asset",
      "description": "Capital equipment, buildings, machinery, land, and ponds",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Asset unique ID" },
        "name": { "type": "string", "description": "Asset name" },
        "category": { "type": "string", "description": "Asset category" },
        "purchaseDate": { "type": "string", "description": "Purchase date" },
        "originalCost": { "type": "number", "description": "Original cost" },
        "usefulLifeYears": { "type": "number", "description": "Useful life in years" },
        "salvageValue": { "type": "number", "description": "Estimated salvage value" },
        "accumulatedDepreciation": { "type": "number", "description": "Accumulated depreciation" },
        "currentBookValue": { "type": "number", "description": "Current book value" },
        "status": { "type": "string", "description": "ACTIVE or DISPOSED" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "name", "category", "purchaseDate", "originalCost"]
    },
    "party": {
      "title": "Party",
      "description": "Customer, supplier, or vendor master profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Party unique ID" },
        "type": { "type": "string", "enum": ["CUSTOMER", "SUPPLIER", "BOTH"] },
        "name": { "type": "string", "description": "Party name" },
        "phone": { "type": "string", "description": "Phone number" },
        "address": { "type": "string", "description": "Address" },
        "balance": { "type": "number", "description": "Current balance" },
        "creditLimit": { "type": "number", "description": "Credit limit" },
        "isActive": { "type": "boolean", "description": "Active status" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "type", "name", "phone"]
    },
    "closedPeriod": {
      "title": "Closed Accounting Period",
      "description": "Locked financial period closure record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Closed period ID" },
        "endDate": { "type": "string", "description": "Period end date" },
        "startDate": { "type": "string", "description": "Period start date" },
        "netProfitTransferred": { "type": "number", "description": "Net profit transferred to retained earnings" },
        "closedAt": { "type": "string", "description": "Closure timestamp" },
        "closedBy": { "type": "string", "description": "User who closed the period" },
        "journalEntryId": { "type": "string", "description": "Closing journal entry ID" },
        "voucherNumber": { "type": "string", "description": "Closing voucher number" },
        "notes": { "type": "string", "description": "Notes" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "endDate", "netProfitTransferred", "closedAt"]
    },
    "salesReturn": {
      "title": "Sales Return",
      "description": "Customer return invoice record with inventory and account adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Return ID" },
        "returnNumber": { "type": "string", "description": "Return number" },
        "saleId": { "type": "string", "description": "Original sales ID" },
        "customerId": { "type": "string", "description": "Customer party ID" },
        "date": { "type": "string", "description": "Return date" },
        "totalRefundAmount": { "type": "number", "description": "Refund amount" },
        "refundMethod": { "type": "string", "enum": ["CASH", "BANK", "ADJUST_DUE"] },
        "bankAccountId": { "type": "string", "description": "Bank account ID" },
        "journalEntryId": { "type": "string", "description": "Journal entry ID" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "returnNumber", "saleId", "customerId", "date", "totalRefundAmount", "refundMethod"]
    },
    "purchaseReturn": {
      "title": "Purchase Return",
      "description": "Supplier return invoice record with inventory and account adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Return ID" },
        "returnNumber": { "type": "string", "description": "Return number" },
        "purchaseId": { "type": "string", "description": "Original purchase ID" },
        "supplierId": { "type": "string", "description": "Supplier party ID" },
        "date": { "type": "string", "description": "Return date" },
        "totalRefundAmount": { "type": "number", "description": "Refund amount" },
        "refundMethod": { "type": "string", "enum": ["CASH", "BANK", "ADJUST_DUE"] },
        "bankAccountId": { "type": "string", "description": "Bank account ID" },
        "journalEntryId": { "type": "string", "description": "Journal entry ID" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "returnNumber", "purchaseId", "supplierId", "date", "totalRefundAmount", "refundMethod"]
    },
    "advancePayment": {
      "title": "Advance Payment",
      "description": "Customer advance received or supplier advance paid tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Advance ID" },
        "advanceNumber": { "type": "string", "description": "Advance number" },
        "partyId": { "type": "string", "description": "Party ID" },
        "amount": { "type": "number", "description": "Advance amount" },
        "direction": { "type": "string", "enum": ["RECEIVED", "PAID"] },
        "paymentMethod": { "type": "string", "enum": ["CASH", "BANK"] },
        "date": { "type": "string", "description": "Advance date" },
        "journalEntryId": { "type": "string", "description": "Journal entry ID" },
        "synced": { "type": "boolean", "description": "Sync status" }
      },
      "required": ["id", "partyId", "amount", "direction", "paymentMethod", "date"]
    }
  },
  "firestore": {
    "/system/config": {
      "schema": "systemConfig",
      "description": "Global ERP settings for The Goated Farm"
    },
    "/system/authSecrets": {
      "schema": "authSecrets",
      "description": "Server-only bcrypt hashes of owner PINs (Admin SDK only)"
    },
    "/accounts/{accountId}": {
      "schema": "account",
      "description": "Chart of accounts"
    },
    "/journalEntries/{entryId}": {
      "schema": "journalEntry",
      "description": "General journal vouchers"
    },
    "/animals/{animalId}": {
      "schema": "livestockAnimal",
      "description": "Livestock animals"
    },
    "/fishBatches/{batchId}": {
      "schema": "fishBatch",
      "description": "Aquaculture fish batches"
    },
    "/cropCycles/{cycleId}": {
      "schema": "cropCycle",
      "description": "Agricultural crop cycles"
    },
    "/auditLogs/{logId}": {
      "schema": "auditLog",
      "description": "Security and business transaction audit logs"
    },
    "/sales/{saleId}": {
      "schema": "journalEntry",
      "description": "Sales invoice and voucher records"
    },
    "/purchases/{purchaseId}": {
      "schema": "journalEntry",
      "description": "Purchase bill and voucher records"
    },
    "/inventoryItems/{itemId}": {
      "schema": "inventoryItem",
      "description": "Inventory stock and products"
    },
    "/stockMovements/{movementId}": {
      "schema": "stockMovement",
      "description": "Inventory stock movement records"
    },
    "/reminders/{reminderId}": {
      "schema": "auditLog",
      "description": "Farm operation task reminders"
    },
    "/payments/{paymentId}": {
      "schema": "paymentRecord",
      "description": "Invoice payment receipts and disbursements"
    },
    "/cashBankAccounts/{accId}": {
      "schema": "cashBankAccount",
      "description": "Cash, bank, and mobile financial accounts"
    },
    "/loans/{loanId}": {
      "schema": "loan",
      "description": "Bank and personal loan obligations"
    },
    "/investors/{investorId}": {
      "schema": "investor",
      "description": "Farm equity partner and investor profiles"
    },
    "/fixedAssets/{assetId}": {
      "schema": "fixedAsset",
      "description": "Long-term farm property, plant, and equipment"
    },
    "/parties/{partyId}": {
      "schema": "party",
      "description": "Customer and supplier records"
    },
    "/bankTransfers/{transferId}": {
      "schema": "auditLog",
      "description": "Bank and cash transfer transactions"
    },
    "/animalEvents/{eventId}": {
      "schema": "auditLog",
      "description": "Livestock feeding, healthcare, and growth logs"
    },
    "/internalFlows/{flowId}": {
      "schema": "auditLog",
      "description": "Internal farm resource and permaculture flows"
    },
    "/processingRuns/{runId}": {
      "schema": "auditLog",
      "description": "Processing and manufacturing runs"
    },
    "/ponds/{pondId}": {
      "schema": "fishBatch",
      "description": "Ponds and aquaculture water bodies"
    },
    "/plots/{plotId}": {
      "schema": "cropCycle",
      "description": "Agricultural land plots"
    },
    "/accessLogs/{logId}": {
      "schema": "auditLog",
      "description": "User security access logs"
    },
    "/recurringExpenseTemplates/{templateId}": {
      "schema": "auditLog",
      "description": "Monthly recurring auto-booking expense templates"
    },
    "/closedPeriods/{periodId}": {
      "schema": "closedPeriod",
      "description": "Closed accounting periods"
    },
    "/salesReturns/{returnId}": {
      "schema": "salesReturn",
      "description": "Customer return records"
    },
    "/purchaseReturns/{returnId}": {
      "schema": "purchaseReturn",
      "description": "Supplier return records"
    },
    "/advancePayments/{advanceId}": {
      "schema": "advancePayment",
      "description": "Customer and supplier advance payment records"
    }
  }
}
