# The Goted Farm ERP — Environment Configuration

# Server-Side Gemini API Key (if AI features requested)
GEMINI_API_KEY=

# Optional: Firebase Service Account Private Key (JSON string or path to serviceAccountKey.json)
# If provided, enables Admin SDK to sign Firebase Auth custom tokens in container dev mode.
# When deployed on Cloud Functions / Firebase Blaze, Firebase supplies this automatically.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Email Provider Configuration (Choose one for outbound OTP delivery)
# 1. Resend (Easiest API method)
RESEND_API_KEY=

# 2. SendGrid API
SENDGRID_API_KEY=

# 3. SMTP (e.g., Gmail App Password or custom mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender email address
EMAIL_FROM="The Goted Farm <noreply@thegotedfarm.com>"
